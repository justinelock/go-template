# =============================================================================
# go-template 本地环境变量模板
# 复制为 configs/.env 后按需修改；勿提交生产密钥。
# 加载顺序：系统环境变量 > configs/.env > 根目录 .env > configs/app.<env>.json
# 字段说明见 configs/README.md、docs/architecture/config.md
# =============================================================================

# --- 服务端口 ---
GATEWAY_SERVICE_PORT=8180
MEMBER_SERVICE_PORT=8181
MEMBER_SERVICE_GRPC_PORT=9181
ORDER_SERVICE_PORT=8182

# --- 运行环境 ---
# dev 对应 configs/app.dev.json；也可用 CONFIG_FILE 指定其它 JSON
APP_ENV=dev
# CONFIG_FILE=configs/app.dev.json

# --- 网关 → 下游回退地址（Consul 关闭或发现失败时使用）---
MEMBER_SERVICE_URL=http://127.0.0.1:8181
MEMBER_SERVICE_GRPC_ADDR=127.0.0.1:9181
ORDER_SERVICE_URL=http://127.0.0.1:8182
# 鉴权是否优先走 member gRPC introspect（false 则 HTTP）
GATEWAY_USE_MEMBER_GRPC=false

# --- MySQL（member / order 共用）---
MYSQL_DSN=root:Root123456@tcp(127.0.0.1:3306)/go_template_db?charset=utf8mb4&parseTime=true&loc=Local

# --- Redis（token、幂等、分布式锁）---
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=redis1234
REDIS_DB=0

# --- 消息队列（order-service 异步结算）---
# rabbitmq（默认）| rocketmq；详见 docs/architecture/mq.md
MQ_PROVIDER=rabbitmq
# true：Rabbit 启动时自动声明 exchange/queue；生产建议 false 并由运维预建
MQ_AUTO_DECLARE=true
# mq_provider=rabbitmq 时必填
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
# mq_provider=rocketmq 时必填（NameServer 地址）
ROCKETMQ_NAMESRV=127.0.0.1:9876

# --- Consul 服务发现（可选）---
CONSUL_ENABLED=false
CONSUL_ADDRESS=127.0.0.1:8500
CONSUL_DATACENTER=dc1
# 注册到 Consul 时使用的 host（容器内填服务名）
SERVICE_HOST=127.0.0.1

# --- 跨域 ---
CORS_ALLOW_ORIGIN=http://localhost:5173
